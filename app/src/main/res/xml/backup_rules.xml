<?xml version="1.0" encoding="utf-8"?><!--
   Правила резервного копирования для устройств с Android 12 (API 31) и ниже.

   Каталог оригиналов исключён: оригиналы восстанавливаются из сети по URL,
   а их суммарный объём может быть большим. Список URL остаётся в копии —
   он небольшой и позволяет открыть галерею без сети после восстановления.
   Кэш приложения (cacheDir) в резервные копии не попадает по умолчанию.

   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="images/originals" />
</full-backup-content>
