<?xml version="1.0" encoding="utf-8"?><!--
   Правила извлечения данных для Android 12 (API 31) и выше.

   Каталог оригиналов исключён из облачной копии и из переноса на другое
   устройство: оригиналы восстанавливаются из сети по URL, а их суммарный
   объём может быть большим. Список URL остаётся в копии — он небольшой и
   позволяет открыть галерею без сети после восстановления.
   Кэш приложения (cacheDir) в копии не попадает по умолчанию.

   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="images/originals" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images/originals" />
    </device-transfer>
</data-extraction-rules>
